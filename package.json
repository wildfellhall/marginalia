{
  "name": "marginalia",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/store-art.mjs && node scripts/prepare-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/store-art.mjs && node scripts/prepare-pdf-assets.mjs",
    "build": "vite build && node scripts/build-extension.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify.mjs",
    "test:extension": "node scripts/verify-extension.mjs",
    "test:folders": "node scripts/verify-folders.mjs",
    "store:art": "node scripts/store-art.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "release": "npm run build && node scripts/package-release.mjs && node scripts/check-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:test": "node scripts/verify-package.mjs",
    "release:pack-test": "node scripts/verify-chrome-pack.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/italiana": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "dompurify": "^3.2.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^7.1.3"
  }
}
